= link_to(incident_path(incident, **carried_params), class: "card p-4 column gap-2 ring-1 #{ incident.open? ? 'ring-white/10 hover:ring-white/20' : 'ring-white/5 opacity-60' }") do
  .row.items-start.justify-between.flex-wrap.gap-3
    .column.gap-1
      span.text-sm.text-gray-100 = incident.title
      .row.flex-wrap.gap-x-4 class="text-[11px] text-gray-500"
        span = "#{ t('observatory.incidents.row.constrained') }: #{ incident.constrained_resource }"
        - if incident.primary_contributor.present?
          span.truncate = incident.primary_contributor
        span = incident.started_at.strftime('%d %b %H:%M')
        span = observatory_seconds(incident.duration_seconds)
    .row.items-center.gap-2.shrink-0
      - if incident.occurrence_count > 1
        span class="text-[10px] text-gray-600" = "×#{ incident.occurrence_count }"
      span class="text-[10px] uppercase tracking-wider px-2 py-1 rounded ring-1 #{ observatory_severity_class(incident.severity) }"
        = incident.severity
